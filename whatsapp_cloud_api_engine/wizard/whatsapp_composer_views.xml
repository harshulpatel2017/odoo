<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_composer_form" model="ir.ui.view">
        <field name="name">whatsapp.composer.form</field>
        <field name="model">whatsapp.composer</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <sheet>
                    <div class="row">
                        <!-- Left Column: Inputs -->
                        <div class="col-lg-7 col-md-12">
                            <group>
                                <group>
                                    <field name="partner_id" widget="res_partner_many2one"
                                           context="{'show_address': 0, 'show_vat': False}"/>
                                    <field name="phone" placeholder="+919876543210"/>
                                </group>
                                <group>
                                    <field name="template_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="use_meta_template" invisible="not template_id"/>
                                    <field name="res_model" invisible="1"/>
                                    <field name="res_id" invisible="1"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Message Text" name="message_text">
                                    <field name="body" placeholder="Write your WhatsApp message here or choose a template..."
                                           widget="text" nolabel="1"/>
                                </page>
                                <page string="Attachments" name="attachments">
                                    <field name="attachment_ids" widget="many2many_binary" string="Attach Documents / PDF"/>
                                </page>
                            </notebook>
                        </div>
                        
                        <!-- Right Column: Live Chat Preview -->
                        <div class="col-lg-5 col-md-12">
                            <div class="card p-3 shadow-sm bg-light">
                                <h6 class="card-title text-center text-muted mb-3">
                                    <i class="fa fa-whatsapp text-success me-1" title="WhatsApp Preview"/> Live Customer View Preview
                                </h6>
                                <field name="preview_html" widget="html" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_send_whatsapp" string="Send WhatsApp Now" type="object"
                            class="btn-success" icon="fa-paper-plane"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_composer" model="ir.actions.act_window">
        <field name="name">WhatsApp Message Composer</field>
        <field name="res_model">whatsapp.composer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
