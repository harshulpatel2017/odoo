<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron 1: Process Queued & Retry Failed Messages -->
        <record id="ir_cron_whatsapp_retry_queue" model="ir.cron">
            <field name="name">WhatsApp: Process Retry Queue</field>
            <field name="model_id" ref="model_whatsapp_message_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed_messages()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron 2: Automated Overdue Invoice Payment Reminders -->
        <record id="ir_cron_whatsapp_payment_reminders" model="ir.cron">
            <field name="name">WhatsApp: Automated Payment Reminders</field>
            <field name="model_id" ref="model_whatsapp_message_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_payment_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
