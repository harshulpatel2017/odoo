<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp Engine" string="WhatsApp Engine" name="whatsapp_cloud_api_engine">
                    <block title="Meta WhatsApp Cloud API Configuration" id="meta_cloud_config">
                        <setting string="Sandbox Simulator Mode"
                                 help="Run WhatsApp Engine in offline demo/simulation mode without calling external Meta servers. Perfect for GitHub showcases and testing.">
                            <field name="whatsapp_sandbox_mode" widget="boolean_toggle"/>
                        </setting>

                        <setting string="Meta Graph API Base URL" help="Official Meta Graph API endpoint URL">
                            <field name="whatsapp_api_url" placeholder="https://graph.facebook.com/v19.0"/>
                        </setting>

                        <setting string="Phone Number ID" help="Assigned Phone Number ID from Meta WhatsApp Cloud console">
                            <field name="whatsapp_phone_number_id" placeholder="105938472918274"/>
                        </setting>

                        <setting string="WABA Account ID" help="WhatsApp Business Account ID from Meta Business Manager">
                            <field name="whatsapp_account_id" placeholder="294857291039485"/>
                        </setting>

                        <setting string="Permanent Access Token" help="System User Token with whatsapp_business_messaging permissions">
                            <field name="whatsapp_access_token" password="True"/>
                        </setting>

                        <setting string="Webhook Verify Token" help="Arbitrary token used to verify incoming Meta webhook subscriptions">
                            <field name="whatsapp_webhook_verify_token"/>
                        </setting>

                        <setting string="Connection Check" help="Verify Sandbox simulator or live Meta Cloud API credentials.">
                            <button name="action_test_whatsapp_connection" type="object"
                                    string="Test API / Sandbox Connection"
                                    class="btn btn-outline-success" icon="fa-check-circle"/>
                        </setting>
                    </block>

                    <block title="Automated Workflow Triggers" id="workflow_triggers">
                        <setting string="Sales Order Confirmation" help="Auto-send WhatsApp confirmation upon Sales Order validation">
                            <field name="whatsapp_auto_send_sale"/>
                        </setting>

                        <setting string="Customer Invoice Post" help="Auto-send WhatsApp PDF invoice when customer invoice is posted">
                            <field name="whatsapp_auto_send_invoice"/>
                        </setting>

                        <setting string="Delivery Transfer Done" help="Auto-send WhatsApp tracking notification upon picking validation">
                            <field name="whatsapp_auto_send_delivery"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_whatsapp_config_settings" model="ir.actions.act_window">
        <field name="name">WhatsApp Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'whatsapp_cloud_api_engine', 'bin_size': False}</field>
    </record>
</odoo>
