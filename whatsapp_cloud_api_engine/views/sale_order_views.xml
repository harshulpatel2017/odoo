<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_whatsapp_composer" string="Send via WhatsApp"
                        type="object" class="btn-outline-success" icon="fa-whatsapp"
                        invisible="state not in ('draft', 'sent', 'sale')"/>
            </xpath>
        </field>
    </record>
</odoo>
