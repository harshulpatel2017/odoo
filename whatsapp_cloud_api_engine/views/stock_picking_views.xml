<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_whatsapp_composer" string="Send via WhatsApp"
                        type="object" class="btn-outline-success" icon="fa-whatsapp"
                        invisible="state not in ('assigned', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>
